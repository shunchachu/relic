  <!-- Modal: Plant Story Details (已修正內容無法顯示問題) -->
  <div id="plantStoryModal" class="fixed inset-0 z-50 flex items-center justify-center px-4 bg-black/40 backdrop-blur-sm hidden opacity-0 transition-opacity duration-300">
    <div class="glass-card rounded-3xl p-6 sm:p-7 max-w-sm w-full shadow-2xl text-center border border-wabi-gold/40">
      <div id="modalPlantIcon" class="text-6xl mb-2 filter drop-shadow-md">🌺</div>
      <span id="modalPlantStageTag" class="text-[10px] px-2 py-0.5 rounded-full bg-wabi-moss/10 text-wabi-moss font-serif">盛開階段</span>
      <h3 id="modalPlantName" class="font-serif font-bold text-xl mt-2 text-wabi-ink dark:text-stone-100">紅色山茶花</h3>
      <p id="modalPlantMeaning" class="text-xs text-wabi-clay italic font-serif my-1">花語：謙遜的美德、深沉且執著的愛</p>
      
      <div class="mt-3 p-3.5 rounded-2xl bg-wabi-sand/40 dark:bg-stone-800/50 text-left text-xs space-y-2 border border-wabi-sand/60">
        <div>
          <span class="text-[10px] text-wabi-stone block" data-i18n="plantStoryLabel">綁定時光手札 / 承諾：</span>
          <span id="modalPlantStory" class="font-medium text-wabi-ink dark:text-stone-200">陪媽媽學會筍乾排骨湯的火候</span>
        </div>
        <div class="flex items-center justify-between text-[11px] pt-1 border-t border-wabi-sand/50 text-wabi-stone">
          <span><span data-i18n="waterCountLabel">澆灌次數：</span><span id="modalPlantWaterCount" class="font-mono font-bold text-wabi-clay">5</span> 次</span>
          <span><span data-i18n="cultivationTimesLabel">培育次數：</span><span id="modalPlantCultivations" class="font-mono font-bold text-wabi-moss">18</span> 次</span>
        </div>
      </div>

      <div class="mt-5 flex flex-col gap-2">
        <div class="flex gap-2">
          <button onclick="waterCurrentPlantFromModal()" class="flex-1 py-2 rounded-xl bg-wabi-moss text-white text-xs font-medium hover:bg-opacity-90 transition flex items-center justify-center gap-1">
            <span>💧</span> <span data-i18n="waterPlantBtn">澆水滋養 (+1)</span>
          </button>
          <button onclick="openEditPlantModalFromDetail()" class="px-3.5 py-2 rounded-xl border border-wabi-sand hover:border-wabi-clay text-xs text-wabi-stone hover:text-wabi-ink flex items-center justify-center gap-1">
            <span>✏️</span> <span data-i18n="editBtn">編輯</span>
          </button>
        </div>
        <div class="flex gap-2">
          <button onclick="promptDeleteCurrentPlant()" class="flex-1 py-2 rounded-xl border border-red-200 dark:border-red-900/40 text-red-500 hover:bg-red-50 dark:hover:bg-red-900/20 text-xs transition flex items-center justify-center gap-1">
            <span>✂️</span> <span data-i18n="prunePlantBtn">告別並修剪此花木</span>
          </button>
          <button onclick="closePlantStoryModal()" class="px-4 py-2 rounded-xl text-xs text-wabi-stone hover:text-wabi-ink border border-wabi-sand" data-i18n="closeBtn">關閉</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Toast Message -->
  <div id="toast" class="fixed bottom-6 left-1/2 transform -translate-x-1/2 z-50 px-4 py-2.5 rounded-2xl glass-card border border-wabi-gold/50 shadow-lg text-xs font-serif text-wabi-ink dark:text-stone-100 hidden opacity-0 transition-opacity duration-300">
    <span id="toastMsg">提示文字</span>
  </div>

  <script>
    let isPremium = false;
    let currentLang = 'zh-TW';
    let currentOS = 'ios';
    let currentTargetId = '1';

    let gardenPlants = [
      {
        id: 'p1',
        name: '深情山茶花',
        variety: 'camellia',
        meaning: '花語：謙遜的美德、深沉且執著的愛',
        story: '為媽媽做的一頓晚餐與手作筍乾排骨湯',
        stage: 3,
        waterCount: 7,
        cultivations: 18,
        icons: ['🌱', '🌿', '🌺']
      },
      {
        id: 'p2',
        name: '青翠若竹',
        variety: 'bamboo',
        meaning: '花語：堅定長青、長久不滅的陪伴心意',
        story: '深夜在客廳聽她細數童年最想去的城市',
        stage: 3,
        waterCount: 9,
        cultivations: 24,
        icons: ['🌱', '🎋', '🎍']
      }
    ];

    let currentInspectingPlantId = null;

    // 修正：植物故事/承諾對話框開啟並精確綁定資料
    function openPlantStoryModal(plantId) {
      const plant = gardenPlants.find(p => p.id === plantId);
      if (!plant) return;

      currentInspectingPlantId = plantId;
      const stageIndex = Math.min(plant.icons.length - 1, plant.stage - 1);
      const icon = plant.icons[stageIndex] || '🌱';
      const stageName = plant.stage === 1 ? '幼苗階段' : (plant.stage === 2 ? '含苞階段' : '盛開階段');

      document.getElementById('modalPlantIcon').textContent = icon;
      document.getElementById('modalPlantStageTag').textContent = stageName;
      document.getElementById('modalPlantName').textContent = plant.name;
      document.getElementById('modalPlantMeaning').textContent = plant.meaning;
      document.getElementById('modalPlantStory').textContent = plant.story || '尚未填寫手札陪伴承諾';
      document.getElementById('modalPlantWaterCount').textContent = plant.waterCount;
      document.getElementById('modalPlantCultivations').textContent = plant.cultivations || plant.waterCount * 2;

      const m = document.getElementById('plantStoryModal');
      m.classList.remove('hidden');
      setTimeout(() => m.classList.remove('opacity-0'), 10);
    }

    function waterCurrentPlantFromModal() {
      if (!currentInspectingPlantId) return;
      const p = gardenPlants.find(item => item.id === currentInspectingPlantId);
      if (!p) return;

      p.waterCount += 1;
      p.cultivations = (p.cultivations || 0) + 1;
      if (p.stage < 3 && p.waterCount >= p.stage * 4) {
        p.stage += 1;
      }
      openPlantStoryModal(currentInspectingPlantId);
      renderGarden();
      showToast(`💧 已為「${p.name}」灌溉！`);
    }

    function closePlantStoryModal() {
      const m = document.getElementById('plantStoryModal');
      m.classList.add('opacity-0');
      setTimeout(() => m.classList.add('hidden'), 300);
    }

    function renderGarden() {
      const container = document.getElementById('gardenPlots');
      if (!container) return;
      container.innerHTML = '';

      gardenPlants.forEach(p => {
        const stageIndex = Math.min(p.icons.length - 1, p.stage - 1);
        const icon = p.icons[stageIndex] || '🌱';
        const stageName = p.stage === 1 ? '初生幼苗' : (p.stage === 2 ? '青翠含苞' : '燦爛盛開');

        const col = document.createElement('div');
        col.className = "flex flex-col items-center group cursor-pointer p-2 rounded-2xl transition duration-300 hover:bg-wabi-sand/40 dark:hover:bg-stone-800/40";
        col.onclick = () => openPlantStoryModal(p.id);

        col.innerHTML = `
          <div class="w-16 h-24 sm:w-20 sm:h-28 flex items-center justify-center text-4xl sm:text-5xl transform group-hover:scale-110 transition duration-300">
            ${icon}
          </div>
          <div class="w-12 h-3 rounded-full bg-wabi-ink/10 dark:bg-stone-700/50 mt-1 blur-[1px]"></div>
          <span class="text-xs font-serif font-medium mt-2 text-wabi-ink dark:text-stone-200">${p.name}</span>
          <div class="flex items-center gap-1 mt-0.5">
            <span class="text-[10px] px-1.5 py-0.2 rounded bg-wabi-moss/15 text-wabi-moss font-sans">${stageName}</span>
          </div>
        `;
        container.appendChild(col);
      });
    }

    function showToast(msg) {
      const t = document.getElementById('toast');
      document.getElementById('toastMsg').textContent = msg;
      t.classList.remove('hidden');
      setTimeout(() => t.classList.remove('opacity-0'), 10);
      setTimeout(() => {
        t.classList.add('opacity-0');
        setTimeout(() => t.classList.add('hidden'), 300);
      }, 3000);
    }

    window.addEventListener('DOMContentLoaded', () => {
      renderGarden();
    });
  </script>
